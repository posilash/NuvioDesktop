# Maintainer: posi <posiibrahim@gmail.com>

pkgname=nuvio-desktop
_pkgname=nuvio
pkgver=0.1.20_alpha.r2412.g4652268d
pkgrel=1
pkgdesc="A modern media hub desktop application (git)"
arch=('x86_64')
url="https://github.com/posilash/NuvioDesktop"
license=('GPL-3.0-or-later')
# No Java: the Compose distributable bundles its own jlink runtime. The X libs
# stay because the host still runs AWT's event queue.
depends=('mpv' 'libwpe' 'wpebackend-fdo' 'wpewebkit' 'wayland' 'libglvnd'
         'gcc-libs' 'libx11' 'libxext' 'libxi' 'libxrender' 'libxtst')
makedepends=('git' 'java-environment>=17' 'gcc' 'meson' 'ninja' 'pkgconf'
             'vulkan-headers' 'luajit' 'mujs' 'wayland-protocols')
provides=("${pkgname}")
# The fork carries the render API this host needs: a Vulkan backend, a
# non-blocking render(), and the target colour space fields. Stock libmpv
# answers NOT_IMPLEMENTED; an mpv without the colour space fields builds and
# then silently gives SDR. Installed here so it goes with the package.
source=("${pkgname}::git+${url}.git#branch=render-api-vulkan"
        "mpv::git+https://github.com/posilash/mpv.git#branch=master")
sha256sums=('SKIP'
            'SKIP')

# Anon credentials, compiled in. Sign-in fails when unset.
_supabase_url="https://api.nuvio.tv"
_supabase_anon_key="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzgxNTIxMzQ2LCJleHAiOjE5MzkyMDEzNDZ9.tmQaj682pwzehpqlgCDMnySOqiUvpgRbrE43T4VJpDI"
_supabase_fallback_url="https://api-two.nuvioapp.space"

pkgver() {
	cd "${srcdir}/${pkgname}"
	local ver
	ver=$(grep -oP '(?<=^VERSION_NAME=).*' composeApp/Configuration/DesktopVersion.properties)
	printf "%s.r%s.g%s" "${ver//-/_}" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
	cd "${srcdir}/${pkgname}"

	# Gitignored, and the build fails without it.
	cat >local.properties <<EOF
NUVIO_SUPABASE_URL=${_supabase_url}
NUVIO_SUPABASE_ANON_KEY=${_supabase_anon_key}
NUVIO_SUPABASE_FALLBACK_URL=${_supabase_fallback_url}
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
EOF

	# Skia's GrGLMakeNativeInterface() checks glXGetCurrentContext(), which is
	# always null under Wayland, and the host dies at DirectContext.makeGL.
	# Only the guard is wrong; the entry points resolve fine.
	cat >"${srcdir}/glxshim.c" <<'EOF'
void *glXGetCurrentContext(void) { return (void *) 1; }
EOF
}

build() {
	gcc -shared -fPIC -o "${srcdir}/libglxshim.so" "${srcdir}/glxshim.c"

	# libmpv only.
	cd "${srcdir}/mpv"
	meson setup build \
		--prefix=/usr \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Dlibmpv=true \
		-Dcplayer=false \
		-Dmanpage-build=disabled \
		-Dlua=enabled \
		-Djavascript=enabled \
		-Dgl=enabled \
		-Dvulkan=enabled \
		-Dwayland=enabled \
		-Dx11=enabled \
		-Dlibbluray=disabled
	meson compile -C build

	cd "${srcdir}/${pkgname}"
	./gradlew --no-daemon :waylandHost:createReleaseDistributable --no-configuration-cache
}

package() {
	cd "${srcdir}/${pkgname}"

	install -d "${pkgdir}/opt/${_pkgname}"
	cp -Rp "waylandHost/build/compose/binaries/main-release/app/Nuvio/." \
		"${pkgdir}/opt/${_pkgname}/"

	# Beside the runtime: the host finds libmpv relative to its own jar.
	install -Dm755 "${srcdir}/mpv/build/libmpv.so.2" \
		"${pkgdir}/opt/${_pkgname}/lib/libmpv.so.2"
	install -Dm755 "${srcdir}/libglxshim.so" \
		"${pkgdir}/opt/${_pkgname}/lib/libglxshim.so"

	# Wrapper, not a symlink: the launcher resolves the runtime relative to the
	# app image, and LD_PRELOAD has to be set before the JVM starts.
	install -Dm755 /dev/stdin "${pkgdir}/usr/bin/${_pkgname}" <<'EOF'
#!/bin/sh
export LD_LIBRARY_PATH="/opt/nuvio/lib:/opt/nuvio/lib/runtime/lib:${LD_LIBRARY_PATH}"
export LD_PRELOAD="/opt/nuvio/lib/libglxshim.so${LD_PRELOAD:+:${LD_PRELOAD}}"
exec "/opt/nuvio/bin/Nuvio" "$@"
EOF

	install -Dm644 dist/desktop/nuvio.desktop \
		"${pkgdir}/usr/share/applications/${_pkgname}.desktop"
	install -Dm644 composeApp/src/desktopMain/resources/icons/nuvio-app-icon-transparent.png \
		"${pkgdir}/usr/share/icons/hicolor/256x256/apps/${_pkgname}.png"
}
