# Maintainer: posi <posiibrahim@gmail.com>

pkgname=nuvio-desktop
_pkgname=nuvio
pkgver=0.1.20_alpha.r2412.g4652268d
pkgrel=1
pkgdesc="A modern media hub desktop application, native Wayland host (git)"
arch=('x86_64')
url="https://github.com/posilash/NuvioDesktop"
license=('GPL-3.0-or-later')
# The host is a plain application distribution, not a jlink image, so it needs
# a JRE. mpv is here for libmpv's own runtime dependencies -- the bundled
# libmpv.so.2 is built against the same system libraries. The WPE stack backs
# the player chrome; libglvnd and wayland are what the GLFW window and the
# isolated fdo display use.
depends=('java-runtime>=17' 'mpv' 'libwpe' 'wpebackend-fdo' 'wpewebkit'
         'wayland' 'libglvnd' 'gcc-libs')
makedepends=('git' 'java-environment>=17' 'gcc' 'meson' 'ninja' 'pkgconf'
             'vulkan-headers')
provides=("${pkgname}")
conflicts=("${pkgname}")
# The fork carries the render API this host is written against: a gpu-next
# backend ("opengl-next"), a Vulkan backend, and a render() that does not block
# without advanced control. Stock libmpv answers NOT_IMPLEMENTED and the host
# falls back to the legacy GL renderer, which is not what this is for.
source=("${pkgname}::git+${url}.git#branch=render-api-wayland"
        "mpv::git+https://github.com/posilash/mpv.git#branch=vk-hwdec")
sha256sums=('SKIP'
            'SKIP')

# Backend client config. Anon credentials, compiled into the binary as Kotlin
# constants, so they are the same in every build; sign-in fails when unset.
_supabase_url="https://api.nuvio.tv"
_supabase_anon_key="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzgxNTIxMzQ2LCJleHAiOjE5MzkyMDEzNDZ9.tmQaj682pwzehpqlgCDMnySOqiUvpgRbrE43T4VJpDI"
_supabase_fallback_url="https://api-two.nuvioapp.space"

pkgver() {
	cd "${srcdir}/${pkgname}"
	local ver
	ver=$(grep -oP '(?<=^VERSION_NAME=).*' composeApp/Configuration/DesktopVersion.properties)
	printf "%s.r%s.g%s" "${ver//-/_}" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
	cd "${srcdir}/${pkgname}"

	# Gitignored, and the build fails without it.
	cat >local.properties <<EOF
NUVIO_SUPABASE_URL=${_supabase_url}
NUVIO_SUPABASE_ANON_KEY=${_supabase_anon_key}
NUVIO_SUPABASE_FALLBACK_URL=${_supabase_fallback_url}
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
EOF

	# Skia's GrGLMakeNativeInterface() on Linux is GLX-based and returns null
	# when glXGetCurrentContext() does, which under Wayland is always: the
	# context is EGL. The host then dies at DirectContext.makeGL before showing
	# a window. The entry points are fine -- libglvnd's glXGetProcAddress
	# returns dispatch stubs that route to whatever context is current -- so
	# only the guard is wrong.
	cat >"${srcdir}/glxshim.c" <<'EOF'
void *glXGetCurrentContext(void) { return (void *) 1; }
EOF
}

build() {
	gcc -shared -fPIC -o "${srcdir}/libglxshim.so" "${srcdir}/glxshim.c"

	# libmpv only: the player binary, its scripting and its own windowing are
	# all dead weight here.
	cd "${srcdir}/mpv"
	meson setup build \
		--prefix=/usr \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Dlibmpv=true \
		-Dcplayer=false \
		-Dmanpage-build=disabled \
		-Dlua=disabled \
		-Djavascript=disabled
	meson compile -C build

	cd "${srcdir}/${pkgname}"
	# installDist refuses a target that is neither empty nor a previous
	# installation, which a rebuilt package directory always is.
	rm -rf waylandHost/build/install
	./gradlew --no-daemon :waylandHost:installDist --no-configuration-cache
}

package() {
	cd "${srcdir}/${pkgname}"

	install -d "${pkgdir}/opt/${_pkgname}"
	cp -Rp "waylandHost/build/install/waylandHost/." "${pkgdir}/opt/${_pkgname}/"

	install -Dm755 "${srcdir}/libglxshim.so" "${pkgdir}/opt/${_pkgname}/lib/libglxshim.so"
	install -Dm755 "${srcdir}/mpv/build/libmpv.so.2" \
		"${pkgdir}/opt/${_pkgname}/lib/libmpv.so.2"

	# The controls page ships inside the app jar and is unpacked to the user's
	# cache on first run, so nothing needs installing for it.
	install -Dm755 /dev/stdin "${pkgdir}/usr/bin/${_pkgname}" <<'EOF'
#!/bin/sh
export LD_PRELOAD="/opt/nuvio/lib/libglxshim.so${LD_PRELOAD:+:${LD_PRELOAD}}"
JAVA_OPTS="-Dnuvio.wayland.libmpv=/opt/nuvio/lib/libmpv.so.2 ${JAVA_OPTS}"
export JAVA_OPTS
exec /opt/nuvio/bin/waylandHost "$@"
EOF

	install -Dm644 dist/desktop/nuvio.desktop \
		"${pkgdir}/usr/share/applications/${_pkgname}.desktop"
	install -Dm644 composeApp/src/desktopMain/resources/icons/nuvio-app-icon-transparent.png \
		"${pkgdir}/usr/share/icons/hicolor/256x256/apps/${_pkgname}.png"
}
